            "minLength": 2,
            "title": "Language",
            "type": "string"
          },
          "mock_failure_rate": {
            "default": 0.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Mock Failure Rate",
            "type": "number"
          },
          "mock_latency_seconds": {
            "default": 2.0,
            "maximum": 120.0,
            "minimum": 0.0,
            "title": "Mock Latency Seconds",
            "type": "number"
          },
          "notify_on_job_finish": {
            "default": true,
            "title": "Notify On Job Finish",
            "type": "boolean"
          },
          "remote_access": {
            "default": false,
            "title": "Remote Access",
            "type": "boolean"
          },
          "theme": {
            "default": "dark",
            "enum": [
              "dark",
              "light",
              "system"
            ],
            "title": "Theme",
            "type": "string"
          }
        },
        "required": [
          "theme",
          "language",
          "remote_access",
          "notify_on_job_finish",
          "mock_latency_seconds",
          "mock_failure_rate"
        ],
        "title": "AppSettings",
        "type": "object"
      },
